# /etc/config/wstunnel
# UCI config file for wstunnel server

config wstunnel 'server'
    # Whether enable service, optional value: 1 (enable) / 0 (disable)
    option enabled '1'

    # Listen address and port (default: wss://0.0.0.0:443)
    option listen_addr 'wss://0.0.0.0:443'

    # Path prefix auth secret (correspond to --restrict-http-upgrade-path-prefix)
    option secret 'secret'

    # Restrict forward to target address (correspond to --restrict-to)
    # Format: host:port, can add multiple, use space to separate
    option restrict_to 'localhost:51820'

    # Log level (optional: TRACE, DEBUG, INFO, WARN, ERROR, OFF)
    option log_level 'INFO'

    # TLS certificate file path (optional, use for custom certificate)
    # option tls_certificate '/etc/wstunnel/server.crt'
    # TLS private key file path (optional)
    # option tls_private_key '/etc/wstunnel/server.key'